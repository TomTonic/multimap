diff --git a/internal/art/flat_test.go b/internal/art/flat_test.go
index 5d4f5e6..a7017fa 100644
--- a/internal/art/flat_test.go
+++ b/internal/art/flat_test.go
@@ -217,3 +217,28 @@ func TestPointerFree(t *testing.T) {
 		}
 	}
 }
+
+// TestReachInFirstValue makes sure that range queries over long keys fetch
+// the right memory ahead: the first value of each key, not a neighbouring
+// object. The scan of the ART (touchChildren) reads the byte at key length
+// plus reach.val from every flat leaf; for every value type alignment and
+// every key length a flat leaf holds, that byte must lie inside the leaf's
+// first value.
+func TestReachInFirstValue(t *testing.T) {
+	check := func(name string, r reach, off func(klen int) uintptr, size uintptr) {
+		for klen := 0; klen <= maxFlatKey; klen++ {
+			if b := uintptr(klen) + r.val; b < off(klen) || b >= off(klen)+size {
+				t.Fatalf("%s, key of %d bytes: byte %d lies outside the first value at [%d, %d)", name, klen, b, off(klen), off(klen)+size)
+			}
+		}
+	}
+	check("uint8", (&Map[uint8]{flat: 1}).reach(), flatOff[uint8], 1)
+	check("uint16", (&Map[uint16]{flat: 1}).reach(), flatOff[uint16], 2)
+	check("uint32", (&Map[uint32]{flat: 1}).reach(), flatOff[uint32], 4)
+	check("uint64", (&Map[uint64]{flat: 1}).reach(), flatOff[uint64], 8)
+	check("[3]uint32", (&Map[[3]uint32]{flat: 1}).reach(), flatOff[[3]uint32], 12)
+	check("[2]uint64", (&Map[[2]uint64]{flat: 1}).reach(), flatOff[[2]uint64], 16)
+	if r := (&Map[string]{flat: -1}).reach(); r.val != 0 {
+		t.Fatalf("set leaves only: reach.val = %d, want 0", r.val)
+	}
+}
diff --git a/internal/art/map.go b/internal/art/map.go
index b112131..5f29aeb 100644
--- a/internal/art/map.go
+++ b/internal/art/map.go
@@ -176,15 +176,26 @@ func (m *Map[T]) leafTail() uintptr {
 	return unsafe.Sizeof(leaf[T, [16]byte]{}) - 1
 }
 
+// reach returns what the scan touches ahead in this map's leaves (see
+// touchChildren): the smallest leaf's last byte and, with flat leaves, the
+// first value behind a long key.
+func (m *Map[T]) reach() reach {
+	if m.flat > 0 {
+		var z T
+		return reach{tail: m.leafTail(), val: 3 + unsafe.Sizeof(z)}
+	}
+	return reach{tail: m.leafTail()}
+}
+
 // Range calls fn for every key within b, in ascending key order, until fn
 // returns false. The key belongs to the map: fn must not modify or retain
 // it, and must not modify the map.
 func (m *Map[T]) Range(b *Bounds, fn func(key []byte) bool) {
-	m.t.scan(b, m.leafTail(), func(l *leafHead) bool { return fn(l.key()) })
+	m.t.scan(b, m.reach(), func(l *leafHead) bool { return fn(l.key()) })
 }
 
 // RangeValues calls yield for every value of every key within b, key by key
 // in ascending key order, until yield returns false.
 func (m *Map[T]) RangeValues(b *Bounds, yield func(T) bool) {
-	m.t.scan(b, m.leafTail(), func(l *leafHead) bool { return eachValue(l, yield) })
+	m.t.scan(b, m.reach(), func(l *leafHead) bool { return eachValue(l, yield) })
 }
